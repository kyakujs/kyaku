{
  "name": "@kyakujs/zero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./src/auth.ts"
    },
    "./mutators": {
      "types": "./dist/mutators.d.ts",
      "default": "./src/mutators.ts"
    },
    "./queries": {
      "types": "./dist/queries.d.ts",
      "default": "./src/queries.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "yarn with-env zero-cache-dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@kyakujs/kyaku": "workspace:*",
    "@rocicorp/zero": "^1.9.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@kyakujs/eslint-config": "workspace:*",
    "@kyakujs/tailwind-config": "workspace:*",
    "@kyakujs/tsconfig": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "oxfmt": "^0.70.0",
    "typescript": "^6.0.3"
  }
}
