    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.11.2",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@kyakujs/tsconfig": "workspace:*",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "oxfmt": "^0.70.0",
    "typescript": "^6.0.3"
  }
